{
  "name": "agent-staff",
  "version": "0.8.0",
  "description": "AGY Staff workflow with selectable AGY, Grok Build, and Cursor CLI backends.",
  "keywords": [
    "pi-package",
    "opencode-plugin"
  ],
  "license": "MIT",
  "files": [
    "skills/",
    "pi-skills/",
    "opencode-skills/",
    "opencode.mjs",
    "companion/",
    "templates/",
    "scripts/generate-skills.mjs",
    "docs/INSTALL_FOR_AGENTS.md",
    "docs/REFERENCE*.md",
    "README.zh-CN.md",
    "bin/",
    "plugins/",
    ".codex-plugin/",
    ".claude-plugin/",
    ".agents/plugins/",
    "NOTICE",
    "PRD.md",
    "scripts/build-plugins.mjs",
    "docs/backend-contracts.md",
    "docs/acceptance-matrix.md",
    "docs/implementation-report.md",
    "PLAN.md"
  ],
  "scripts": {
    "generate:pi": "node scripts/generate-skills.mjs --target=pi",
    "check:pi": "node scripts/generate-skills.mjs --target=pi --check",
    "test": "node --test tests/*.test.mjs",
    "test:pi": "node --test tests/pi.integration.mjs",
    "generate:opencode": "node scripts/generate-skills.mjs --target=opencode",
    "check:opencode": "node scripts/generate-skills.mjs --target=opencode --check",
    "generate:skills": "node scripts/generate-skills.mjs",
    "check:skills": "node scripts/generate-skills.mjs --check",
    "test:opencode": "node --test tests/opencode.integration.mjs",
    "pack:checked": "npm run check:skills && npm run check:plugins && npm pack --ignore-scripts",
    "prepublishOnly": "npm run check:skills && npm run check:plugins",
    "build:plugins": "node scripts/build-plugins.mjs",
    "check:plugins": "node scripts/build-plugins.mjs --check"
  },
  "pi": {
    "skills": [
      "./pi-skills"
    ]
  },
  "main": "./opencode.mjs",
  "exports": "./opencode.mjs",
  "engines": {
    "opencode": ">=1.18.34 <2",
    "node": ">=24"
  },
  "bin": {
    "agent-staff": "bin/agent-staff.mjs",
    "agy-staff": "bin/agy-staff.mjs",
    "grok-staff": "bin/grok-staff.mjs",
    "cursor-staff": "bin/cursor-staff.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanHuangNLP/agent-staff.git"
  },
  "homepage": "https://github.com/RyanHuangNLP/agent-staff#readme",
  "bugs": {
    "url": "https://github.com/RyanHuangNLP/agent-staff/issues"
  }
}
